# PostgreSQL (ex.: Supabase, pooler em session mode, porta 5432). Codifique caracteres especiais da senha (@ vira %40).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Endereço público do site: monta links de convite e metadados (SEO, compartilhamento)
APP_URL=http://localhost:3000

# Resend (envio dos e-mails de convite)
RESEND_API_KEY=
# Remetente: só preencha para forçar um endereço (ex.: em teste). Vazio usa as caixas do
# navelo.com.br definidas em src/lib/email/senders.ts
EMAIL_FROM=

# Segredo do servidor (hash dos tokens de sessão e convite). Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Hosts extras autorizados (reverse proxy/túnel), separados por vírgula. Ex.: app.navelo.com.br
# (navelo.com.br e www.navelo.com.br já entram sozinhos quando APP_ENV=production)
ALLOWED_ORIGINS=

# Supabase Storage (arquivos dos documentos e notas fiscais)
# A URL é https://<ref-do-projeto>.supabase.co e a chave é a service_role (segredo de servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documentos

# --- Usuários do banco (homologação e produção) ---------------------------------------------
# Três usuários, três poderes. Em desenvolvimento pode deixar só DATABASE_URL com o dono.
#   DATABASE_URL          -> navelo_app: a aplicação. Sujeito ao RLS, sem DDL.
#   DATABASE_ADMIN_URL    -> navelo_admin: fluxos de sistema (login, convite, senha, sessões,
#                            auditoria). Ignora o RLS, não altera estrutura.
#   DATABASE_MIGRATE_URL  -> dono do banco: só para `npm run db:migrate` e `npm run db:roles`.
# Definir DATABASE_ADMIN_URL liga o modo RLS da aplicação (src/db/index.ts).
# No pooler do Supabase o usuário é <papel>.<ref-do-projeto>.
DATABASE_ADMIN_URL=
DATABASE_MIGRATE_URL=

# --- Ambiente ----------------------------------------------------------------------------------
# production | staging | development. PRODUÇÃO PRECISA SER DITA DE FORMA EXPLÍCITA: sem esta
# variável o site se trata como teste (tag laranja no topo, nada indexado, assunto de e-mail com
# [TESTE]). Em production, navelo.com.br e www.navelo.com.br passam a ser origens permitidas.
APP_ENV=development
