# PostgreSQL (ex.: Supabase, pooler em session mode, porta 5432). Codifique caracteres especiais da senha (@ vira %40).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Endereço público do site: monta links de convite e metadados (SEO, compartilhamento)
APP_URL=http://localhost:3000

# Resend (envio dos e-mails de convite)
RESEND_API_KEY=
# Remetente: só preencha para forçar um endereço (ex.: em teste). Vazio usa as caixas do
# navelo.com.br definidas em src/lib/email/senders.ts
EMAIL_FROM=

# Segredo do servidor (hash dos tokens de sessão e convite). Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Hosts extras autorizados (reverse proxy/túnel), separados por vírgula. Ex.: app.navelo.com.br
ALLOWED_ORIGINS=

# Supabase Storage (arquivos dos documentos e notas fiscais)
# A URL é https://<ref-do-projeto>.supabase.co e a chave é a service_role (segredo de servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documentos
